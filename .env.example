# Database Config
POSTGRES_USER=my_db_user
POSTGRES_PASSWORD=my_db_password
POSTGRES_DB=my_database
DATABASE_URL=postgresql://my_db_user:my_db_password@db:5432/my_database

# Security
SECRET_KEY=generate_a_secure_random_key_here
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080
FRONTEND_URL=http://localhost:3000
PORTAL_TOKEN_EXPIRE_DAYS=30
# "production" desliga /docs, /redoc e /openapi.json (docker-compose.prod.yml já define isso).
# Deixe em branco/"development" localmente para manter a documentação interativa da API.
ENVIRONMENT=development

# ARC company identity used in emails and generated PDFs
COMPANY_NAME=ARC ERP
COMPANY_CONTACT=ERP de interiores e arquitetura
COMPANY_ADDRESS=
COMPANY_DOCUMENT=

# Seeded Admin Credentials
ADMIN_EMAIL=admin@meudominio.com.br
ADMIN_PASSWORD=replace_with_a_unique_strong_password

# Production only (required by docker-compose.prod.yml)
# CORS_ORIGINS=https://erp.example.com
# CLOUDFLARE_TUNNEL_TOKEN=replace_with_cloudflare_tunnel_token
# COOKIE_SECURE=true
